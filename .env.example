# Local development values. NEVER use these secrets outside your machine.
# In AWS every secret comes from Secrets Manager (architecture §12).

# HTTP port of the API.
PORT=3000
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The app connects as the least-privilege role acme_app (no UPDATE/DELETE on ledger and audit).
DATABASE_URL=postgres://acme_app:acme_app_local@localhost:5442/acme
# Migrations connect as the database owner and create acme_app with APP_DB_PASSWORD if it is missing.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5442/acme
APP_DB_PASSWORD=acme_app_local

# SEC-01: HS256 secret shared with fake-login (min 32 chars).
JWT_SECRET=local-dev-jwt-secret-change-me-0000000000
# SEC-03: API key of the card network (min 16 chars).
NETWORK_API_KEY=local-dev-network-key-0000
# SEC-04: HMAC secret of the bank webhooks (min 32 chars) and replay window in seconds.
BANK_WEBHOOK_SECRET=local-dev-bank-webhook-secret-00000000
BANK_SIGNATURE_TOLERANCE_SECONDS=300

# SPEND-09: an open hold expires this many days after the authorization.
HOLD_TTL_DAYS=7
# CLOSE-03 / OQ-03: days a closing account waits for late captures.
CLOSING_CAPTURE_WINDOW_DAYS=30
# OQ-10: minimum collateral deposit in centavos (50000 = 500.00 MXN).
MIN_DEPOSIT_CENTAVOS=50000
# MONEY-05: largest single amount in centavos (100000000 = 1,000,000.00 MXN).
MAX_AMOUNT_CENTAVOS=100000000
